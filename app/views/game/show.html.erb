<% if flash[:message] %>
   <div class="alert alert-danger">
     <span class="error"><%= flash[:message] %></span>
   </div>
<% end %>

<div class="alert alert-warning">
  <p class="lead">
    Wrong Guesses:
    <span class="guesses"><%= @game.wrong_guesses %></span>
  </p>
</div>

<p class="alert alert-success">
  Word so far:
  <span class="word"><%= @game.word_with_guesses %></span>
</p>

<%= form_with url: guess_path, method: :post do |form| %>
  <div class="form-group row">
    <%= form.label :guess, 'Guess a letter:', class: "col-md-2 col-form-label" %>
    <%= form.text_field :guess, autocomplete: 'off', class: "form-control col-md-1" %>
    <%= form.submit 'Guess!', class: "col-md-2 btn btn-success" %>
  </div>
<% end %>

<%= render :template => 'game/new' %>
